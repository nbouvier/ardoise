# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Embedded PGlite database (local development)
.pglite/

# Test coverage
coverage/

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# OS / editor
.DS_Store

# Keys and credential files: never committed anywhere in the repository
# (docs/guidelines/SECURITY.md)
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
google-services.json
GoogleService-Info.plist
credentials*.json
service-account*.json

# Deployment: per-machine state that lives next to the scripts on the server
deploy/release.env
deploy/backups/
deploy/.deploy.lock/
