# Copy to `backup-offsite.env` next to the scripts (for example
# /opt/ardoise/production/backup-offsite.env) and chmod 600 it. Never commit the
# real file. Read by backup-offsite.sh; see docs/OPERATIONS.md.
#
# Docker reads this file: KEY=value, no quotes, no spaces around `=`.

# The restic repository: an S3-compatible bucket, private, ideally in Europe.
RESTIC_REPOSITORY=s3:https://s3.example.com/ardoise-backups

# Encrypts the repository. Lose it and every backup is unreadable: keep a copy
# outside the machine (a password manager).
RESTIC_PASSWORD=change-me

# Access key of the bucket, limited to that bucket.
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
# Only if the provider asks for a region.
# AWS_DEFAULT_REGION=auto

# Optional. A healthchecks.io-style check URL: pinged at the start, on success and
# on failure. Set its schedule to daily: no ping means the backup did not run.
# PING_URL=https://hc-ping.example.com/your-check-id
