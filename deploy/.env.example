# Copy to `.env` on the server, in the environment's directory (for example
# /opt/ardoise/production/.env), and chmod 600 it. Never commit the real file.
# Every variable is explained in docs/OPERATIONS.md.

# production | staging. Names the compose project (and so its containers, network
# and database volume): the two environments never share any of them.
DEPLOY_ENV=production

# Host port the server is published on (loopback only). The proxy forwards to it:
# keep production and staging apart if they share a machine (3000 / 3001).
SERVER_PORT=3000

# Password of the database user. It is placed in a URL: use only letters and
# digits, for example `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me

# Public address of this API, https, no trailing slash. Invitation links are built
# from it.
PUBLIC_BASE_URL=https://api.example.com

# Accepted Google OAuth client IDs, comma-separated (web, iOS, Android).
GOOGLE_CLIENT_IDS=xxxx-web.apps.googleusercontent.com,xxxx-android.apps.googleusercontent.com

# Secret signing the access tokens, at least 16 characters: `openssl rand -base64 48`.
# Changing it signs every user out.
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# Memory ceilings of this environment's containers (Docker sizes: 512m, 1g…). Past
# its ceiling a container is restarted. The defaults suit a small machine; lower them
# for staging if it is tight. The migration step uses the server's.
# DB_MEMORY_LIMIT=1g
# SERVER_MEMORY_LIMIT=512m

# Optional.
# LOG_LEVEL=info
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.example.app
# APP_STORE_URL=
