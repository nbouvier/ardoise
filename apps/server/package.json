{
  "name": "@splitcount/server",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "drizzle-kit migrate",
    "migrate:deploy": "node dist/scripts/migrate.js",
    "migrate:generate": "drizzle-kit generate",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@splitcount/shared": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "google-auth-library": "^11.0.2",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
