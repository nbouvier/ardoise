# Copy to .env and adjust. Never commit the real .env file.

# Runtime environment: development | test | production.
# Defaults to production when unset (so a forgotten variable cannot skip the
# production checks): keep NODE_ENV=development for local work.
NODE_ENV=development

# HTTP port the API listens on
PORT=3000

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Postgres connection string. Leave unset in local development to use the
# embedded PGlite database (no external Postgres needed). Required in production:
# the server refuses to start without it when NODE_ENV=production.
# DATABASE_URL=postgres://user:password@localhost:5432/splitcount

# Directory for the embedded PGlite database in development.
PGLITE_DATA_DIR=.pglite

# Accepted Google OAuth client IDs, comma-separated (web, iOS, Android).
# Created in Google Cloud Console -> APIs & Services -> Credentials.
GOOGLE_CLIENT_IDS=xxxx-web.apps.googleusercontent.com,xxxx-ios.apps.googleusercontent.com,xxxx-android.apps.googleusercontent.com

# Secret for signing SplitCount access tokens (>= 16 chars). Generate a random value.
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# Token lifetimes in seconds (optional; sensible defaults applied).
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=5184000

# Publicly reachable base URL of this API. Invitation links are built from it, so
# it must be an address the recipient's device can actually open. In local
# development with a USB device, keep localhost and run `adb reverse tcp:3000 tcp:3000`.
# Required in production, where it must not point at localhost / a loopback address.
PUBLIC_BASE_URL=http://localhost:3000

# Proxies in front of the server that may set X-Forwarded-For (a load balancer),
# so the server sees the real client address. One of:
#   false                    no proxy in front: ignore X-Forwarded-For
#   <number>                 trust that many proxy hops, e.g. 1 for a single load balancer
#   <CIDR>[,<CIDR>...]       trust those proxy addresses, e.g. 10.0.0.0/8
#   true                     trust every hop (clients can then forge their address)
# Required in production; defaults to false elsewhere.
TRUST_PROXY=false

# Rate limits, in requests per minute and client address (optional; defaults shown).
# Counted per server process: with N instances behind the load balancer the effective
# limit is up to N times higher. AUTH is shared by every /auth/* route, PUBLIC by the
# unauthenticated invitation routes (GET /invites/:code and GET /i/:code).
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_PUBLIC_PER_MINUTE=30

# How long a shutdown (SIGTERM / SIGINT) waits for in-flight requests before exiting
# anyway, in seconds (optional; default 25). Keep it below the platform's kill timeout.
SHUTDOWN_TIMEOUT_SECONDS=25

# Invitation lifetime in seconds, friend and group alike (optional; default 7 days).
INVITE_TTL_SECONDS=604800

# Store listings shown on the invitation landing page. Leave unset until published.
# APP_STORE_URL=https://apps.apple.com/app/id000000000
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.ardoise
