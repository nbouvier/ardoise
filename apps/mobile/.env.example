# Copy to .env and adjust. Real .env files are git-ignored.
# These EXPO_PUBLIC_* values are bundled into the client (not secret).

# SplitCount API base URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Google OAuth client IDs from Google Cloud Console -> Credentials.
# Web client ID: required by the native SDK to return an ID token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx-web.apps.googleusercontent.com
# iOS client ID: required for iOS builds (drives the reversed URL scheme).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx-ios.apps.googleusercontent.com
