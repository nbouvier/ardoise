# Copy to .env and adjust. Real .env files are git-ignored.
# These EXPO_PUBLIC_* values are bundled into the client (not secret).

# Ardoise API base URL, as reachable *from the device running the app*:
#   - USB device / emulator: keep localhost and run `adb reverse tcp:3000 tcp:3000`
#   - Wi-Fi device on the same network: use the computer's LAN IP, e.g. http://192.168.1.x:3000
#   - web target: http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Google OAuth client IDs from Google Cloud Console -> Credentials.
# Web client ID: required by the native SDK to return an ID token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx-web.apps.googleusercontent.com
# iOS client ID: required for iOS builds (drives the reversed URL scheme).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx-ios.apps.googleusercontent.com

# Sentry error reporting. Leave unset locally: without a DSN the app reports nothing.
# Release builds and updates get these from the EAS environment variables instead
# (docs/MOBILE.md, "Error reporting (Sentry)").
#   SENTRY_DSN          the mobile project's DSN; not secret, it only lets a client send reports
#   SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN
#                       build time only, for the source-map upload; the token IS secret
# SENTRY_DSN=https://<key>@<org-id>.ingest.de.sentry.io/<project-id>

# Application id override (Android package / iOS bundle identifier). Leave unset: the
# id is app.json's (app.ardoise). Only for a fork publishing its own build; it then needs
# its own Google OAuth Android client (matched by package name + signing SHA-1).
# APP_ID=com.example.app
